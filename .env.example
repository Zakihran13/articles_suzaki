# App
ENV=development
PYTHONPATH=.

GUARDIAN_OPEN_PLATFORM_API=1234-5678-90123

# Database
DATABASE_URL=sqlite:///data/processed/portfolio.db
POSTGRESQL_DB_USER="postgres"
POSTGRESQL_DB_PASSWORD="password234"
POSTGRESQL_DB_HOST="localhost"
POSTGRESQL_DB_PORT=5432
POSTGRESQL_DB_NAME="postgres"


# MONGO_URI="mongodb://admin:password@localhost:27017/"
MONGO_URI="mongodb://localhost:27017/"
MONGO_DB_NAME="articles_raw"
MONGO_COLL_METADATA="news_metadata"
MONGO_COLL_NEWS="news_raw"


# Data Source Configuration
# Choose 'api' to use Guardian API or 'mock' for testing with synthetic data
DATA_SOURCE=api

# Mock data source settings (only used when DATA_SOURCE=mock)
# Total number of synthetic articles to generate
MOCK_TOTAL_ARTICLES=1000000
# Articles per search result page
MOCK_BATCH_SIZE=10
# Random seed for reproducibility (optional, omit for random data)
# MOCK_SEED=42

# Transformation settings (MongoDB -> PostgreSQL)
# Date range (UTC, TO is exclusive). Leave both empty for daily mode (yesterday + today).
# Historical example: TRANSFORM_FROM_DATE=2024-01-01 / TRANSFORM_TO_DATE=2024-02-01
TRANSFORM_FROM_DATE=
TRANSFORM_TO_DATE=
# Documents read per MongoDB batch
TRANSFORM_EXTRACT_BATCH_SIZE=100
# Rows inserted per PostgreSQL staging minibatch
TRANSFORM_MINIBATCH_SIZE=500
